
SECRET_KEY=django-insecure-docker-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DB_ENGINE=django.db.backends.postgresql
DB_NAME=askme
DB_USER=askme
DB_PASSWORD=askme_password
DB_HOST=db
DB_PORT=5432

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Email (MailDev) ────────────────────────────────────────────
EMAIL_HOST=maildev
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@askme.local

# ── Centrifugo ─────────────────────────────────────────────────
CENTRIFUGO_URL=http://centrifugo:8000
CENTRIFUGO_API_KEY=my-api-key-secret
CENTRIFUGO_SECRET=my-token-secret